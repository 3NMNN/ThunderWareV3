 local Tab = Window:CreateTab("Maps", nil)
 
 local Section = Tab:CreateSection("Custom map loader")
 
 local InsertService = game:GetService("InsertService")
 local Players = game:GetService("Players")
 
 local player = Players.LocalPlayer
 
 local mapIdInput = ""
 
 local Input = Tab:CreateInput({
    Name = "Map ID",
    CurrentValue = "",
    PlaceholderText = "Enter asset ID",
    RemoveTextAfterFocusLost = false,
    Flag = "MapIdInput",
 
    Callback = function(Text)
       mapIdInput = Text
    end,
 })
 
local ApplyMapButton = Tab:CreateButton({
    Name = "Apply map",
    Callback = function()
       local player = Players.LocalPlayer
       if not player or not player.Character then
          Rayfield:Notify({Title = "Error", Content = "Player not ready", Duration = 3})
          return
       end

       local hrp = player.Character:FindFirstChild("HumanoidRootPart")
       if not hrp then
          Rayfield:Notify({Title = "Error", Content = "HumanoidRootPart not found", Duration = 3})
          return
       end

       if not mapIdInput or mapIdInput == "" then
          Rayfield:Notify({Title = "Error", Content = "Please enter a map ID", Duration = 3})
          return
       end

       local id = tonumber(mapIdInput) or tonumber(tostring(mapIdInput):match("(%d+)"))
       if not id then
          Rayfield:Notify({Title = "Error", Content = "Invalid map ID format", Duration = 3})
          return
       end

       -- Teleport player high so the map will spawn beneath them
       hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 500, hrp.Position.Z)
       Rayfield:Notify({Title = "Map", Content = "Loading map...", Duration = 2})

       local ok, asset = pcall(function()
          return InsertService:LoadAsset(id)
       end)

       if not ok or not asset then
          Rayfield:Notify({Title = "Error", Content = "Failed to load asset: " .. tostring(asset), Duration = 5})
          return
       end

       -- Find the main model
       local mapModel = nil
       for _, obj in ipairs(asset:GetChildren()) do
          if obj:IsA("Model") then
             mapModel = obj
             break
          end
       end

       if not mapModel then
          -- Try to find BasePart
          for _, obj in ipairs(asset:GetChildren()) do
             if obj:IsA("BasePart") then
                mapModel = Instance.new("Model")
                obj.Parent = mapModel
                break
             end
          end
       end

       if not mapModel then
          Rayfield:Notify({Title = "Error", Content = "No valid model found in asset", Duration = 3})
          return
       end

       mapModel.Name = "SpawnedMap"
       local existingSpawn = workspace:FindFirstChild("SpawnedMap")
       if existingSpawn then
          existingSpawn:Destroy()
       end
       mapModel.Parent = workspace

       -- Position map below player
       local successBBox, bboxCFrame, bboxSize = pcall(function()
          return mapModel:GetBoundingBox()
       end)

       if successBBox and bboxCFrame and bboxSize then
          local topHalf = bboxSize.Y / 2
          local targetY = hrp.Position.Y - 5 - topHalf
          local offset = Vector3.new(0, targetY - bboxCFrame.Position.Y, 0)
          for _, part in ipairs(mapModel:GetDescendants()) do
             if part:IsA("BasePart") then
                part.CFrame = part.CFrame + offset
             end
          end
       end

       Rayfield:Notify({Title = "Success", Content = "Map loaded successfully!", Duration = 3})
    end
 })
 
 
 
 
 
 
 
 






