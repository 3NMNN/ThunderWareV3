--// Cleaner Evade Bounce Spot Visualizer
--// Softer red so spots are easier to see
--// Toggle = B

local Workspace = game:GetService("Workspace")
local UIS = game:GetService("UserInputService")

-- SETTINGS
local TOGGLE_KEY = Enum.KeyCode.B

local REFRESH_TIME = 8
local MAX_PARTS = 500

local MIN_ANGLE = 0.15
local MAX_ANGLE = 0.92

local enabled = false

local folder = Instance.new("Folder")
folder.Name = "BounceVisualizer"
folder.Parent = Workspace

local visuals = {}

-- CLEAR
local function clearESP()

    for _,v in pairs(visuals) do
        if v then
            v:Destroy()
        end
    end

    table.clear(visuals)
end

-- DETECT BOUNCEABLE PARTS
local function isBounceSpot(part)

    if not part:IsA("BasePart") then
        return false
    end

    if part.Size.Magnitude < 6 then
        return false
    end

    if not part.CanCollide then
        return false
    end

    if part.Transparency > 0.7 then
        return false
    end

    local y = math.abs(part.CFrame.UpVector.Y)

    return y > MIN_ANGLE and y < MAX_ANGLE
end

-- CREATE CLEANER VISUAL
local function createESP(part)

    -- SOFT RED OVERLAY
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Size = part.Size + Vector3.new(0.05,0.05,0.05)

    -- DARKER RED
    box.Color3 = Color3.fromRGB(180, 40, 40)

    -- MORE TRANSPARENT
    box.Transparency = 0.65

    box.Parent = folder

    -- THIN OUTLINE
    local outline = Instance.new("SelectionBox")
    outline.Adornee = part

    outline.LineThickness = 0.03
    outline.Color3 = Color3.fromRGB(255,255,255)

    outline.SurfaceTransparency = 1

    outline.Parent = folder

    table.insert(visuals, box)
    table.insert(visuals, outline)
end

-- SCAN
local function scan()

    clearESP()

    if not enabled then
        return
    end

    local count = 0

    for _,part in ipairs(Workspace:GetDescendants()) do

        if count >= MAX_PARTS then
            break
        end

        if isBounceSpot(part) then

            createESP(part)

            count += 1
        end
    end
end

-- TOGGLE
UIS.InputBegan:Connect(function(input, gp)

    if gp then
        return
    end

    if input.KeyCode == TOGGLE_KEY then

        enabled = not enabled

        if enabled then
            scan()
            print("Bounce Visualizer ON")
        else
            clearESP()
            print("Bounce Visualizer OFF")
        end
    end
end)

-- AUTO REFRESH
task.spawn(function()

    while true do

        task.wait(REFRESH_TIME)

        if enabled then
            scan()
        end
    end
end)

