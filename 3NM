        local configNames = {'None'}
        for name, config in pairs(configs) do
            table.insert(configNames, name)
        end
        
        table.sort(configNames)
        configDropdown:SetValues(configNames)
        Library:Notify('Config list refreshed!', 2)
    end,
})

LeftMisc:AddButton({
    Text = 'Load Selected Config',
    Func = function()
        if selectedLoadConfig == '' or selectedLoadConfig == 'None' then
            Library:Notify('Select a config first!', 3)
            return
        end
        
        local configName = selectedLoadConfig
        
        if not configs[configName] then
            Library:Notify('Config not found!', 3)
            return
        end
        
        Library:Notify('📂 Config "' .. configName .. '" loaded!', 3)
    end,
})

LeftMisc:AddButton({
    Text = 'Delete Selected Config',
    Func = function()
        if selectedLoadConfig == '' or selectedLoadConfig == 'None' then
            Library:Notify('Select a config first!', 3)
            return
        end
        
        local configName = selectedLoadConfig
        
        if configs[configName] then
            configs[configName] = nil
            selectedLoadConfig = ''
            
            -- Refresh the dropdown
            local configNames = {'None'}
            for name in pairs(configs) do
                table.insert(configNames, name)
            end
            table.sort(configNames)
            configDropdown:SetValues(configNames)
            
            Library:Notify('🗑️ Config "' .. configName .. '" deleted!', 3)
