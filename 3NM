local Button = Tab:CreateButton({
   Name = "Remove walls",
   Callback = function()
       -- Safely disable invisible walls. Stores original values so this can be reverted.
       _G.InvisibleWallsOriginals = _G.InvisibleWallsOriginals or {}
       local processed = 0

       local function isPartFromMap(part)
           if not part then return false end
           if workspace:FindFirstChild("SpawnedMap") and part:IsDescendantOf(workspace.SpawnedMap) then
               return true
           end
           if workspace:FindFirstChild("Map") and part:IsDescendantOf(workspace.Map) then
               return true
           end
           if workspace:FindFirstChild("Game") and part:IsDescendantOf(workspace.Game) then
               return true
           end
           return false
       end

       local function disablePart(part)
           if not part or not part:IsA("BasePart") then return end
           if isPartFromMap(part) then
               return
           end
           if not _G.InvisibleWallsOriginals[part] then
               _G.InvisibleWallsOriginals[part] = {CanCollide = part.CanCollide, Transparency = part.Transparency}
           end
           pcall(function()
               part.CanCollide = false
               part.Transparency = 0.5
           end)
           processed = processed + 1
       end

       local wallsFolder = workspace:FindFirstChild("InvisibleWalls")
       if wallsFolder then
           for _, w in ipairs(wallsFolder:GetDescendants()) do
               disablePart(w)
           end
       else
           -- fallback: search for likely invisible walls (high transparency and collide)
           for _, obj in ipairs(workspace:GetDescendants()) do
               if obj:IsA("BasePart") then
                   local nameLower = (obj.Name or ""):lower()
                   local isLikely = false
                   if nameLower:find("invis") or nameLower:find("invisible") then
                       isLikely = true
                   elseif obj.Transparency >= 0.8 and obj.CanCollide then
                       isLikely = true
                   end

                   if isLikely then
                       disablePart(obj)
                   end
               end
           end
       end

       Rayfield:Notify({Title = "Walls", Content = "Processed " .. processed .. " parts (CanCollide disabled)", Duration = 4})
   end,
})

 
 



