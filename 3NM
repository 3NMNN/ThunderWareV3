local configDropdown = LeftMisc:AddDropdown('ConfigLoadList', {
    Text    = 'Select Config',
    Default = 'None',
    Values  = {'None'},
    Callback = function(Value)
        selectedLoadConfig = Value
    end,
})

LeftMisc:AddButton({
    Text = 'Refresh Config List',
