      local map = mapsFolder:FindFirstChild(mapName, true)

      if not map then
         warn("Map not found: "..mapName)
         return
      end

      -- clone map
      local clonedMap = map:Clone()
      clonedMap.Name = "SpawnedMap"
      clonedMap.Parent = workspace

      -- place map below player
      if clonedMap:IsA("Model") then
         clonedMap:PivotTo(CFrame.new(0, 0, 0))
      end

      print("Loaded map:", mapName)

   end,
})



