 local RunService = game:GetService("RunService")
 local Players = game:GetService("Players")
 
 local player = Players.LocalPlayer
 
 local emoteMoveEnabled = false
 local moveSpeed = 45
 
 local connection
 
 local function toggleEmoteMove()
 
     emoteMoveEnabled = not emoteMoveEnabled
 
     if connection then
         connection:Disconnect()
         connection = nil
     end
 
     if not emoteMoveEnabled then
         print("Emote Move Disabled")
         return
     end
 
     connection = RunService.RenderStepped:Connect(function()
 
         local character = player.Character
         if not character then
             return
         end
 
         local humanoid = character:FindFirstChild("Humanoid")
         local hrp = character:FindFirstChild("HumanoidRootPart")
 
         if not humanoid or not hrp then
             return
         end
 
         -- ONLY MOVE WHILE HOLDING Q
         if not UIS:IsKeyDown(Enum.KeyCode.Q) then
             return
         end
 
         local cam = workspace.CurrentCamera
         local moveDir = Vector3.zero
 
         if UIS:IsKeyDown(Enum.KeyCode.W) then
             moveDir = moveDir + cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.S) then
             moveDir = moveDir - cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.A) then
             moveDir = moveDir - cam.CFrame.RightVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.D) then
             moveDir = moveDir + cam.CFrame.RightVector
         end
 
         moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
 
         if moveDir.Magnitude > 0 then
 
             moveDir = moveDir.Unit
 
             hrp.Velocity = Vector3.new(
                 moveDir.X * moveSpeed,
                 hrp.Velocity.Y,
                 moveDir.Z * moveSpeed
             )
         end
     end)
 
     print("Emote Move Enabled")
 end
 
 -- ANY EMOTE MOVE + EVADE EDASH
 -- HOLD Q WHILE EMOTING
 -- SPACE = JUMP
 -- SHIFT = EDASH
 
 local Players = game:GetService("Players")
 local UIS = game:GetService("UserInputService")
 local RunService = game:GetService("RunService")
 
 local player = Players.LocalPlayer
 
 local enabled = false
 local connection
 
 -- SETTINGS
 local moveSpeed = 42
 local edashPower = 135
 local jumpPower = 65
 local edashCooldown = 0.65
 
 local lastDash = 0
 
 -- TOGGLE
 local function toggleSystem()
 
     enabled = not enabled
 
     if connection then
         connection:Disconnect()
         connection = nil
     end
 
     if not enabled then
         print("Any Emote Move Disabled")
         return
     end
 
     connection = RunService.RenderStepped:Connect(function()
 
         local character = player.Character
         if not character then
             return
         end
 
         local humanoid = character:FindFirstChild("Humanoid")
         local hrp = character:FindFirstChild("HumanoidRootPart")
 
         if not humanoid or not hrp then
             return
         end
 
         -- ONLY WORK WHEN HOLDING Q
         if not UIS:IsKeyDown(Enum.KeyCode.Q) then
             return
         end
 
         local cam = workspace.CurrentCamera
         local moveDir = Vector3.zero
 
         -- MOVEMENT
         if UIS:IsKeyDown(Enum.KeyCode.W) then
             moveDir = moveDir + cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.S) then
             moveDir = moveDir - cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.A) then
             moveDir = moveDir - cam.CFrame.RightVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.D) then
             moveDir = moveDir + cam.CFrame.RightVector
         end
 
         moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
 
         if moveDir.Magnitude > 0 then
 
             moveDir = moveDir.Unit
 
             -- SMOOTH EVADE STYLE AIR MOVE
             hrp.Velocity = Vector3.new(
                 moveDir.X * moveSpeed,
                 hrp.Velocity.Y,
                 moveDir.Z * moveSpeed
             )
         end
     end)
 
     print("Any Emote Move Enabled")
 end
 
 -- EDASH + JUMP
 UIS.InputBegan:Connect(function(input, gp)
 
     if gp then
         return
     end
 
     if not enabled then
         return
     end
 
     local character = player.Character
     if not character then
         return
     end
 
     local humanoid = character:FindFirstChild("Humanoid")
     local hrp = character:FindFirstChild("HumanoidRootPart")
 
     if not humanoid or not hrp then
         return
     end
 
     -- ONLY WHILE HOLDING Q
     if not UIS:IsKeyDown(Enum.KeyCode.Q) then
         return
     end
 
     -- EVADE JUMP
     if input.KeyCode == Enum.KeyCode.Space then
 
         humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
 
         hrp.Velocity = Vector3.new(
             hrp.Velocity.X,
             jumpPower,
             hrp.Velocity.Z
         )
     end
 
     -- EVADE EDASH
     if input.KeyCode == Enum.KeyCode.LeftShift then
 
         local now = tick()
 
         if now - lastDash < edashCooldown then
             return
         end
 
         lastDash = now
 
         local cam = workspace.CurrentCamera
 
         local dashDir = Vector3.zero
 
         if UIS:IsKeyDown(Enum.KeyCode.W) then
             dashDir = dashDir + cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.S) then
             dashDir = dashDir - cam.CFrame.LookVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.A) then
             dashDir = dashDir - cam.CFrame.RightVector
         end
 
         if UIS:IsKeyDown(Enum.KeyCode.D) then
             dashDir = dashDir + cam.CFrame.RightVector
         end
 
         -- FORWARD DASH IF NO KEYS
         if dashDir.Magnitude <= 0 then
             dashDir = cam.CFrame.LookVector
         end
 
         dashDir = Vector3.new(dashDir.X, 0, dashDir.Z).Unit
 
         -- EVADE STYLE BOOST
         hrp.Velocity = Vector3.new(
             dashDir.X * edashPower,
             20,
             dashDir.Z * edashPower
         )
     end
 end)
 
 -- BUTTON
 Tab:CreateButton({
     Name = "Any Emote Move-Press Q while using emote",
     Callback = function()
         toggleSystem()
         Rayfield:Notify({
             Title = "ThunderWare",
             Content = "Any Emote Move " .. (enabled and "Enabled" or "Disabled"),
             Duration = 3
         })
     end,
 })
 
 
 
 
 
 
 
 
 
