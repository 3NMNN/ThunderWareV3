local Tab = Window:CreateTab("Maps", nil)

local Section = Tab:CreateSection("Custom map loader")

local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local mapIdInput = ""

local Input = Tab:CreateInput({
   Name = "Map ID",
   CurrentValue = "",
   PlaceholderText = "Enter asset ID",
   RemoveTextAfterFocusLost = false,
   Flag = "MapIdInput",

   Callback = function(Text)
      mapIdInput = Text
   end,
})

local Button = Tab:CreateButton({
   Name = "Apply map",
   Callback = function()
      local player = Players.LocalPlayer
      if not player or not player.Character then
         Rayfield:Notify({Title = "Error", Content = "Player not ready", Duration = 3})
         return
      end

      local hrp = player.Character:FindFirstChild("HumanoidRootPart")
      if not hrp then
         Rayfield:Notify({Title = "Error", Content = "HumanoidRootPart not found", Duration = 3})
         return
      end

      local id = tonumber(mapIdInput) or tonumber(tostring(mapIdInput):match("(%d+)"))
      if not id then
         Rayfield:Notify({Title = "Error", Content = "Invalid map ID", Duration = 3})
         return
      end

      -- Teleport player high so the map will spawn beneath them
      local upOffset = 500
      hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + upOffset, hrp.Position.Z)
      Rayfield:Notify({Title = "Map", Content = "Teleporting up and loading map...", Duration = 2})

      local ok, asset = pcall(function()
         return InsertService:LoadAsset(id)
      end)

      if not ok or not asset then
         Rayfield:Notify({Title = "Error", Content = "Failed to load asset", Duration = 4})
         return
      end

      -- Find the main model inside the returned asset
      local mapModel = nil
      for _, obj in ipairs(asset:GetChildren()) do
         if obj:IsA("Model") then
            mapModel = obj
            break
         elseif obj:IsA("BasePart") then
            -- wrap single-part assets into a model
            mapModel = Instance.new("Model")
            obj.Parent = mapModel
            break
         end
      end
      if not mapModel then
         -- fallback to parenting the whole asset as the model
         mapModel = Instance.new("Model")
         for _, obj in ipairs(asset:GetChildren()) do
            obj.Parent = mapModel
         end
      end

      mapModel.Name = "SpawnedMap"
      mapModel.Parent = workspace

      -- Compute bounding box to determine height and pivot
      local successBBox, bboxCFrame, bboxSize = pcall(function()
         return mapModel:GetBoundingBox()
      end)

      local boxCFrame = bboxCFrame
      local boxSize = bboxSize
      if not successBBox or not boxCFrame or not boxSize then
         -- fallback: compute axis-aligned bounds from parts
         local minX, minY, minZ = math.huge, math.huge, math.huge
         local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
         local partsCount = 0
         for _, p in ipairs(mapModel:GetDescendants()) do
            if p:IsA("BasePart") then
               partsCount = partsCount + 1
               local pos = p.Position
               local half = p.Size * 0.5
               minX = math.min(minX, pos.X - half.X)
               minY = math.min(minY, pos.Y - half.Y)
               minZ = math.min(minZ, pos.Z - half.Z)
               maxX = math.max(maxX, pos.X + half.X)
               maxY = math.max(maxY, pos.Y + half.Y)
               maxZ = math.max(maxZ, pos.Z + half.Z)
            end
         end

         if partsCount > 0 then
            boxSize = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
            boxCFrame = CFrame.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
         else
            boxSize = Vector3.new(0, 0, 0)
            boxCFrame = CFrame.new(0, 0, 0)
         end
      end

      -- Place the map so its top sits a small gap below the player's HRP
      local gap = 5
      local topHalf = (boxSize and boxSize.Y or 0) / 2
      local targetY = hrp.Position.Y - gap - topHalf
      local targetPos = Vector3.new(hrp.Position.X, targetY, hrp.Position.Z)

      -- Move all parts by the offset from the model's current center to the target position
      local offset = targetPos - boxCFrame.Position
      for _, part in ipairs(mapModel:GetDescendants()) do
         if part:IsA("BasePart") then
            part.CFrame = part.CFrame + offset
         end
      end

      Rayfield:Notify({Title = "Map", Content = "Map applied under player", Duration = 3})
   end,
})

