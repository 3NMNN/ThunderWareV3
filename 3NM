local virtualStrafeEnabled = false
local virtualStrafeConnection = nil
local virtualStrafeLastCamera = nil

local Button = Tab:CreateButton({
   Name = "Virtual Strafe",
   Callback = function()
      virtualStrafeEnabled = not virtualStrafeEnabled
      print("Virtual strafe " .. (virtualStrafeEnabled and "enabled" or "disabled"))

      if virtualStrafeEnabled then
         if virtualStrafeConnection then
            virtualStrafeConnection:Disconnect()
            virtualStrafeConnection = nil
         end

         virtualStrafeLastCamera = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
         virtualStrafeConnection = game:GetService("RunService").RenderStepped:Connect(function()
            local player = game.Players.LocalPlayer
            local char = player and player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera

            if not hrp or not camera or not virtualStrafeLastCamera then
               virtualStrafeLastCamera = camera and camera.CFrame
               return
            end

            local currentLook = camera.CFrame.LookVector
            local lastLook = virtualStrafeLastCamera.LookVector
            local dot = math.clamp(currentLook:Dot(lastLook), -1, 1)
            local yawDelta = math.acos(dot)
            local boost = math.clamp(yawDelta * 180, 0, 320)

            if boost > 0.2 then
               local boostVector = Vector3.new(currentLook.X, 0, currentLook.Z) * boost
               hrp.Velocity = Vector3.new(hrp.Velocity.X + boostVector.X, hrp.Velocity.Y, hrp.Velocity.Z + boostVector.Z)
            end

            virtualStrafeLastCamera = camera.CFrame
         end)
      else
         if virtualStrafeConnection then
            virtualStrafeConnection:Disconnect()
            virtualStrafeConnection = nil
         end
         virtualStrafeLastCamera = nil
      end
   end,
})






