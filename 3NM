-- ── Fast Turn ───────────────────────────────
local fastTurnEnabled = false
local fastTurnConnection = nil

RightMain:AddToggle('FastTurn', {
    Text    = 'Fast Turn',
    Default = false,
    Tooltip = 'Hold A/D for quick character rotation',
    Callback = function(Value)
        fastTurnEnabled = Value

        if fastTurnEnabled then
            local RunService = game:GetService('RunService')
            local UserInputService = game:GetService('UserInputService')
            local Players = game:GetService('Players')
            local player = Players.LocalPlayer

            local Settings = {
                TurnSpeed = 0.3, -- Speed of fast turn (A and D)
            }

            local function applyMovementLogic(character)
                local humanoid = character:WaitForChild('Humanoid')
                local rootPart = character:WaitForChild('HumanoidRootPart')

                fastTurnConnection = RunService.RenderStepped:Connect(function()
                    if not character or not character.Parent or not fastTurnEnabled then
                        if fastTurnConnection then
                            fastTurnConnection:Disconnect()
                            fastTurnConnection = nil
                        end
                        return
                    end

                    local pressingA = UserInputService:IsKeyDown(Enum.KeyCode.A)
                    local pressingD = UserInputService:IsKeyDown(Enum.KeyCode.D)

                    -- Disable auto rotate to prevent camera alignment
                    humanoid.AutoRotate = false

                    -- Only rotate if pressing A or D
                    if pressingA or pressingD then
                        local moveDirection = humanoid.MoveDirection
                        if moveDirection.Magnitude > 0 then
                            -- Calculate lateral direction
                            local targetRotation = CFrame.new(rootPart.Position, rootPart.Position + moveDirection)
                            -- Rotate character quickly
                            rootPart.CFrame = rootPart.CFrame:Lerp(targetRotation, Settings.TurnSpeed)
                        end
                    end
                end)
            end

            local char = player.Character
            if char then
                applyMovementLogic(char)
            end

            player.CharacterAdded:Connect(function(character)
                if fastTurnEnabled then
                    applyMovementLogic(character)
                end
            end)

            Library:Notify('Fast Turn ON — hold A/D to turn!', 3)
        else
            if fastTurnConnection then
                fastTurnConnection:Disconnect()
                fastTurnConnection = nil
            end

            -- Restore AutoRotate for all characters
            local char = game.Players.LocalPlayer.Character
            if char then
                local humanoid = char:FindFirstChildOfClass('Humanoid')
                if humanoid then
                    humanoid.AutoRotate = true
                end
            end

            Library:Notify('Fast Turn OFF.', 3)
        end
    end,
})
 
