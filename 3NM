-- Dynamically list available maps from common folders
local function getMapsFolder()
    return game:GetService("ReplicatedStorage"):FindFirstChild("Maps")
        or workspace:FindFirstChild("Maps")
        or game:GetService("ReplicatedStorage"):FindFirstChild("Game")
end

local mapsListed = false
local function listAvailableMaps()
    if mapsListed then return end
    local mf = getMapsFolder()
    if not mf then return end
    local section = Tab:CreateSection("Available Maps")
    for _,m in ipairs(mf:GetChildren()) do
        if m:IsA("Model") or m:IsA("Folder") then
            Tab:CreateButton({
                Name = "Load "..m.Name,
                Callback = function()
                    local clone = m:Clone()
                    clone.Name = "SpawnedMap"
                    for _,existing in ipairs(workspace:GetChildren()) do
                        if existing.Name == "SpawnedMap" then existing:Destroy() end
                    end
                    clone.Parent = workspace
                    if clone:IsA("Model") then
                        clone:PivotTo(CFrame.new(0,0,0))
                    end
                    Rayfield:Notify({Title = "Map", Content = m.Name.." loaded", Duration = 3})
                end,
            })
        end
    end
    mapsListed = true
end

