 local function getMapScale()
    return math.max(0.1, mapScaleValue / 10)
 end
 
 local function getMapSpawnHeight()
    return mapSpawnHeightValue * 100
 end
 
 local function clearSpawnedMap()
    local existing = workspace:FindFirstChild("SpawnedMap")
    if existing then
       existing:Destroy()
    end
 end
 
 local function positionModelUnderPlayer(model, player)
    if not model or not player or not player.Character then
       return
    end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
       return
    end
    local ok, bboxCFrame, bboxSize = pcall(function()
       return model:GetBoundingBox()
    end)
    if not ok or not bboxCFrame or not bboxSize then
       return
    end
    local targetY = hrp.Position.Y + getMapSpawnHeight() - bboxSize.Y / 2
    local offset = Vector3.new(hrp.Position.X, targetY, hrp.Position.Z) - bboxCFrame.Position
    for _, part in ipairs(model:GetDescendants()) do
       if part:IsA("BasePart") then
          part.CFrame = part.CFrame + offset
       end
    end
 end
 
 local function scaleModel(model, scale)
    if not model or scale == 1 then
       return
    end
    local ok, bboxCFrame = pcall(function()
       return model:GetBoundingBox()
    end)
    if not ok or not bboxCFrame then
       return
    end
    for _, part in ipairs(model:GetDescendants()) do
       if part:IsA("BasePart") then
          local orientation = part.CFrame - part.Position
          local relativePos = bboxCFrame:PointToObjectSpace(part.Position)
          part.Size = part.Size * scale
          local newPos = bboxCFrame.Position + relativePos * scale
          part.CFrame = CFrame.new(newPos) * orientation
       end
    end
 end
 
 local function createMapModelFromAsset(asset)
    for _, obj in ipairs(asset:GetChildren()) do
       if obj:IsA("Model") then
          return obj
       end
    end
    for _, obj in ipairs(asset:GetChildren()) do
       if obj:IsA("BasePart") then
          local model = Instance.new("Model")
          obj.Parent = model
          return model
       end
    end
    return nil
 end
 
 local function loadMapAssetById(mapId)
    local ok, asset = pcall(function()
       return InsertService:LoadAsset(mapId)
    end)
    if not ok or not asset then
       return nil, "Failed to load asset"
    end
    local model = createMapModelFromAsset(asset)
    if not model then
       return nil, "No valid model found in asset"
    end
    return model
 end
 
 local function findMapByName(mapName)
    local searchParents = {
       game:GetService("ReplicatedStorage"),
       workspace,
       game:GetService("ServerStorage"),
    }
    for _, parent in ipairs(searchParents) do
       if parent then
          local found = parent:FindFirstChild(mapName, true)
          if found then
             return found
          end
       end
    end
    return nil
 end
 
 local function spawnMap(model, player)
    if not model then
       return false, "No map model"
    end
    clearSpawnedMap()
    model.Name = "SpawnedMap"
    model.Parent = workspace
    local scale = getMapScale()
    scaleModel(model, scale)
    positionModelUnderPlayer(model, player)
    return true
 end
 
 local function loadMapFromAssetId(mapId)
    local player = Players.LocalPlayer
    if not player or not player.Character then
       return false, "Player not ready"
    end
    local model, err = loadMapAssetById(mapId)
    if not model then
       return false, err
    end
    return spawnMap(model, player)
 end
 
 local function loadPresetMap(mapName)
    local player = Players.LocalPlayer
    if not player or not player.Character then
       return false, "Player not ready"
    end
    local source = findMapByName(mapName)
    if not source then
       return false, "Preset map not found: " .. mapName
    end
    local clone = source:Clone()
    return spawnMap(clone, player)
 end
 
