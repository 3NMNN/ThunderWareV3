-- ── Config Management ───────────────────────────
local configs = {}
local currentConfigName = ''

LeftMisc:AddInput('ConfigName', {
    Default     = '',
    Numeric     = false,
    Finished    = false,
    Text        = 'Config Name',
    Placeholder = 'Enter config name',
    Callback    = function(Value)
        currentConfigName = Value
    end,
})

LeftMisc:AddButton({
    Text = 'Create Config',
    Func = function()
        if currentConfigName == '' then
            Library:Notify('Enter a config name first!', 3)
            return
        end
        
        if configs[currentConfigName] then
            Library:Notify('Config "' .. currentConfigName .. '" already exists!', 3)
            return
        end
        
        -- Create config with ALL current settings
        local timestamp = os.date('%Y-%m-%d %H:%M:%S')
        local configData = {
            name = currentConfigName,
            -- Main Tab Settings
            airStrafeEnabled = airStrafeEnabled,
            strafeMult = strafeMult,
            pixelSurfEnabled = pixelSurfEnabled,
            SURF_MAX_SPEED = SURF_MAX_SPEED,
            CLIMB_BOOST = CLIMB_BOOST,
            virtualStrafeMult = virtualStrafeMult,
            -- Visuals Tab Settings
            skyboxID = skyboxID,
            shaderID = shaderID,
            -- Maps Tab Settings
            selectedMap = selectedMap,
            -- Timestamp
            timestamp = timestamp,
            created = os.time()
        }
        
        configs[currentConfigName] = configData
        Library:Notify('✅ Config "' .. currentConfigName .. '" created!', 3)
        
        -- Refresh dropdown with all configs
        local configNames = {'None'}
        for name, cfg in pairs(configs) do
            table.insert(configNames, name)
        end
        
        table.sort(configNames)
        configDropdown:SetValues(configNames)
        Library:Notify('📋 Dropdown updated! Showing ' .. (#configNames - 1) .. ' configs', 2)
    end,
})

LeftMisc:AddButton({
    Text = 'Save Config',
    Func = function()
        if currentConfigName == '' then
            Library:Notify('Enter a config name first!', 3)
            return
        end
        
        if not configs[currentConfigName] then
            Library:Notify('Config not found! Create it first.', 3)
            return
        end
        
        -- Update config with current settings
        configs[currentConfigName] = {
            name = currentConfigName,
            airStrafeEnabled = airStrafeEnabled,
            strafeMult = strafeMult,
            pixelSurfEnabled = pixelSurfEnabled,
            SURF_MAX_SPEED = SURF_MAX_SPEED,
            CLIMB_BOOST = CLIMB_BOOST,
            virtualStrafeMult = virtualStrafeMult,
            skyboxID = skyboxID,
            shaderID = shaderID,
            selectedMap = selectedMap,
            timestamp = os.date('%Y-%m-%d %H:%M:%S'),
            created = configs[currentConfigName].created
        }
        
        Library:Notify('💾 Config "' .. currentConfigName .. '" saved!', 3)
    end,
})

LeftMisc:AddButton({
    Text = 'Load Config',
    Func = function()
        if currentConfigName == '' then
            Library:Notify('Enter a config name first!', 3)
            return
        end
        
        if not configs[currentConfigName] then
            Library:Notify('Config "' .. currentConfigName .. '" not found!', 3)
            return
        end
        
        local config = configs[currentConfigName]
        
        -- Load all settings from config
        strafeMult = config.strafeMult or 120
        SURF_MAX_SPEED = config.SURF_MAX_SPEED or 200
        CLIMB_BOOST = config.CLIMB_BOOST or 22
        virtualStrafeMult = config.virtualStrafeMult or 120
        skyboxID = config.skyboxID or ''
        shaderID = config.shaderID or ''
        selectedMap = config.selectedMap or 'Obby 1'
        
        Library:Notify('📂 Config "' .. currentConfigName .. '" loaded!', 3)
    end,
})

