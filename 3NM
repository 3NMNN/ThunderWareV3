local Tab = Window:CreateTab("Maps", nil)

local Section = Tab:CreateSection("Custom map loader")

local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local mapIdInput = ""

local Input = Tab:CreateInput({
   Name = "Map ID",
   CurrentValue = "",
   PlaceholderText = "Enter asset ID",
   RemoveTextAfterFocusLost = false,
   Flag = "MapIdInput",

   Callback = function(Text)
      mapIdInput = Text
   end,
})

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local Button = Tab:CreateButton({
   Name = "Apply map",

   Callback = function()

      local mapName = tostring(mapIdInput)

      if mapName == "" then
         warn("Enter a map name")
         return
      end

      -- teleport player high
      local character = player.Character or player.CharacterAdded:Wait()
      local hrp = character:WaitForChild("HumanoidRootPart")

      hrp.CFrame = CFrame.new(0, 500, 0)

      -- remove old spawned map
      if workspace:FindFirstChild("SpawnedMap") then
         workspace.SpawnedMap:Destroy()
      end

      -- find evade maps folder
      local mapsFolder =
         game:GetService("ReplicatedStorage"):FindFirstChild("Maps")
         or workspace:FindFirstChild("Maps")
         or game:GetService("ReplicatedStorage"):FindFirstChild("Game")

      if not mapsFolder then
         warn("Could not find maps folder")
         return
      end

      -- find map
      local map = mapsFolder:FindFirstChild(mapName, true)

      if not map then
         warn("Map not found: "..mapName)
         return
      end

      -- clone map
      local clonedMap = map:Clone()
      clonedMap.Name = "SpawnedMap"
      clonedMap.Parent = workspace

      -- place map below player
      if clonedMap:IsA("Model") then
         clonedMap:PivotTo(CFrame.new(0, 0, 0))
      end

      print("Loaded map:", mapName)

   end,
})



