-- ── Invisible Walls ──────────────────────────
local disabledWalls = {}  -- store refs to walls we disabled

local LeftMain  = Tabs.Main:AddLeftGroupbox('Other')

LeftMain:AddButton({
    Text = 'Remove Invisible Walls',
    Func = function()
        disabledWalls = {}  -- clear previous list each run
        local removed = 0
        local player  = game.Players.LocalPlayer
        local char    = player.Character
 
        local function isInvisibleWall(part)
            if not part:IsA('BasePart') then return false end
            if char and part:IsDescendantOf(char) then return false end
            if part.Transparency ~= 1 then return false end
            if not part.CanCollide then return false end
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA('Script') or child:IsA('LocalScript')
                or child:IsA('ModuleScript') or child:IsA('SpecialMesh')
                or child:IsA('UnionOperation') then return false end
            end
            return true
        end
 
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isInvisibleWall(obj) then
                obj.CanCollide = false
                table.insert(disabledWalls, obj)  -- remember it
                removed = removed + 1
            end
        end
 
        Library:Notify('Removed collision from ' .. removed .. ' wall(s).', 4)
    end,
})

LeftMain:AddButton({
    Text = 'Restore Walls',
    Func = function()
        local restored = 0
        for _, part in ipairs(disabledWalls) do
            -- part may have been deleted by the game since we stored it
            if part and part.Parent then
                part.CanCollide = true
                restored = restored + 1
            end
        end
        disabledWalls = {}
        Library:Notify('Restored ' .. restored .. ' wall(s).', 4)
    end,
})



